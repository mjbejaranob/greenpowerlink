---
import Layout from '../layouts/Layout.astro';

const { title, description, features } = Astro.props;
---

<Layout title={`GreenPowerLink | ${title}`}>
  <main class="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-green-500/30 flex flex-col relative overflow-hidden">
    <!-- Ambient Glow Background -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] bg-blue-900/20 blur-[120px] rounded-full"></div>
      <div class="absolute top-[20%] -right-[10%] w-[30%] h-[30%] bg-green-900/20 blur-[100px] rounded-full"></div>
    </div>

    <div class="relative z-10 p-8 md:p-16 max-w-4xl mx-auto w-full flex-grow">
      <a href="/" class="text-blue-400 hover:text-blue-300 transition-colors mb-8 inline-block font-bold tracking-wider uppercase text-sm">← Back to Services</a>
      
      <header class="mb-12">
        <h1 class="text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-green-400">{title}</h1>
        <p class="text-xl text-slate-400">{description}</p>
      </header>

      <section class="bg-slate-900/50 p-8 rounded-2xl border border-slate-800 backdrop-blur-sm shadow-xl">
        <h2 class="text-2xl font-bold mb-6">Key Offerings</h2>
        <ul class="space-y-4">
          {features.map((feature: string) => (
            <li class="flex items-center gap-3 text-slate-300">
              <span class="text-green-500">✔</span> {feature}
            </li>
          ))}
        </ul>
        <slot />
      </section>
    </div>

    <footer class="relative z-10 text-center p-8 text-slate-600 text-xs tracking-widest font-mono">
      © 2026 GreenPowerLink
    </footer>
  </main>
</Layout>
