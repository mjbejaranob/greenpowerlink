---
import '../styles/global.css';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

interface Props {
	title: string;
}

const { title } = Astro.props;

let version = 'dev';
try {
  version = await readFile(join(process.cwd(), 'src/version.txt'), 'utf8');
} catch (e) {
  version = 'unknown';
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">
		<slot />
		<footer class="mt-auto text-center p-8 text-slate-600 text-xs tracking-widest font-mono border-t border-slate-900">
			<a href="/contact" class="hover:text-blue-400 transition-colors">CONTACT US</a> | 
			BUILD: {version.trim()} | © 2026 GreenPowerLink
		</footer>
	</body>
</html>
