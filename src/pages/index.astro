---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GreenPowerLink | Engineering Services">
  <main class="min-h-screen bg-slate-900 text-slate-100 p-8 font-sans">
    <header class="mb-12 border-b border-slate-700 pb-8">
      <h1 class="text-4xl font-bold text-green-400">GreenPowerLink</h1>
      <p class="text-xl text-slate-400 mt-2">High-Tech Engineering & Development Solutions</p>
    </header>

    <section class="grid md:grid-cols-2 gap-8">
      <!-- Web Development -->
      <div class="border border-slate-700 p-6 rounded-lg bg-slate-800 hover:border-green-500 transition-all">
        <h2 class="text-2xl font-semibold mb-4 text-blue-400">Web Development</h2>
        <p class="text-slate-300">Modern, performant, and secure web solutions tailored to your business needs using cutting-edge technologies.</p>
      </div>

      <!-- Product Development -->
      <div class="border border-slate-700 p-6 rounded-lg bg-slate-800 hover:border-green-500 transition-all">
        <h2 class="text-2xl font-semibold mb-4 text-green-400">Product Development</h2>
        <p class="text-slate-300">End-to-end product design, from concept prototyping to final manufacturing readiness.</p>
      </div>
    </section>
  </main>
</Layout>
