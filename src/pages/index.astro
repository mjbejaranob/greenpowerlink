---
import Layout from '../layouts/Layout.astro';

const services = [
  { name: 'Web Development', color: 'blue' },
  { name: 'Product Development', color: 'green' },
  { name: 'PCB Development', color: 'purple' },
  { name: 'Project Management', color: 'yellow' },
  { name: 'Mechanical Drafting', color: 'red' },
];
---

<Layout title="GreenPowerLink | Engineering Services">
  <main class="min-h-screen bg-slate-950 text-slate-100 p-8 md:p-16 font-sans">
    <header class="mb-16">
      <h1 class="text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-green-400">
        GreenPowerLink
      </h1>
      <p class="text-xl text-slate-400 mt-4 max-w-2xl">
        Engineering excellence through innovation. Delivering end-to-end solutions from conceptual design to digital implementation.
      </p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <button class="group relative p-6 bg-slate-900 border border-slate-700 rounded-xl hover:border-slate-500 transition-all duration-300 overflow-hidden text-left shadow-lg">
          <div class={`absolute inset-0 bg-gradient-to-br from-${service.color}-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity`}></div>
          <h2 class="text-xl font-bold mb-2">{service.name}</h2>
          <span class="text-sm text-slate-400 group-hover:text-white transition-colors">Explore Service →</span>
        </button>
      ))}
    </section>
  </main>
</Layout>
