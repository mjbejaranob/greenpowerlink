---
import Layout from '../layouts/Layout.astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { Code, Box, Cpu, GanttChart, DraftingCompass } from 'lucide-astro';

const services = [
  { name: 'Web Development', color: 'blue', icon: Code, desc: 'High-performance digital platforms. From custom web applications to scalable business portals, I build secure, fast, and modern web infrastructure.' },
  { name: 'Product Development', color: 'green', icon: Box, desc: 'Turn concepts into reality. I guide your product through the entire lifecycle, including prototyping, iterative design, and manufacturing readiness.' },
  { name: 'PCB Development', color: 'purple', icon: Cpu, desc: 'Precision electronics design. Expert schematic capture and PCB layout, optimized for signal integrity, thermal management, and manufacturability.' },
  { name: 'Project Management', color: 'yellow', icon: GanttChart, desc: 'Engineering leadership for complex projects. I provide structured oversight, risk mitigation, and technical coordination to ensure your goals are met on time.' },
  { name: 'Mechanical Drafting', color: 'red', icon: DraftingCompass, desc: 'CAD-perfect documentation. Technical drafting and 3D modeling services with a focus on manufacturing tolerances, assemblies, and detailed technical specifications.' },
];

let version = 'dev';
try {
  version = await readFile(join(process.cwd(), 'src/version.txt'), 'utf8');
} catch (e) {
  version = 'unknown';
}
---

<Layout title="GreenPowerLink | Engineering Services">
  <main class="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-green-500/30 flex flex-col">
    <!-- Ambient Glow Background -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] bg-blue-900/20 blur-[120px] rounded-full"></div>
      <div class="absolute top-[20%] -right-[10%] w-[30%] h-[30%] bg-green-900/20 blur-[100px] rounded-full"></div>
    </div>

    <div class="relative z-10 p-8 md:p-16 max-w-6xl mx-auto flex-grow w-full">
      <header class="mb-20 text-center md:text-left">
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-green-400">Engineering</span><br/>
          <span class="text-white">Excellence.</span>
        </h1>
        <p class="text-xl text-slate-400 mt-6 max-w-xl">
          High-tech solutions from conceptual design to digital implementation. Driving innovation, one project at a time.
        </p>
      </header>

      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <a href={`/services/${service.name.toLowerCase().replace(' ', '-')}/`} class="group p-8 bg-slate-900/50 border border-slate-800 rounded-2xl backdrop-blur-sm hover:bg-slate-800/50 hover:border-slate-600 transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-2xl text-left w-full block">
            <div class={`w-12 h-12 mb-6 rounded-lg bg-${service.color}-500/10 flex items-center justify-center border border-${service.color}-500/20 group-hover:scale-110 transition-transform`}>
              <service.icon class={`w-6 h-6 text-${service.color}-500`} />
            </div>
            <h2 class="text-2xl font-bold mb-3">{service.name}</h2>
            <p class="text-slate-400 mb-6 text-sm leading-relaxed">{service.desc}</p>
            <div class="text-xs font-bold tracking-widest uppercase text-slate-500 group-hover:text-white transition-colors">
              Explore →
            </div>
          </a>
        ))}
      </section>
    </div>
  </main>
</Layout>
