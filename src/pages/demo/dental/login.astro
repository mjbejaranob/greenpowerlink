---
import DentalLayout from '../../../layouts/DentalLayout.astro';
---

<DentalLayout title="SmileTech Dental | Staff Login">
  <main class="min-h-screen p-8 flex flex-col items-center justify-center">
    <div class="flex gap-4 mb-8">
      <a href="/demo/dental" class="text-blue-600 font-bold hover:underline">← Back to Portal</a>
      <span class="text-slate-300">|</span>
      <a href="/" class="text-teal-600 font-bold hover:underline">Home Site</a>
    </div>

    <div class="w-full max-w-md bg-white p-10 rounded-3xl shadow-sm border border-blue-100">
      <h1 class="text-3xl font-bold mb-8 text-center text-blue-800">Staff Portal</h1>
      <form class="space-y-6">
        <div>
          <label class="block mb-2 text-sm font-semibold text-slate-700">Username</label>
          <input type="text" placeholder="Employee ID" class="w-full bg-blue-50 p-4 rounded-xl border border-blue-100 focus:border-blue-500 outline-none" />
        </div>
        <div>
          <label class="block mb-2 text-sm font-semibold text-slate-700">Password</label>
          <input type="password" placeholder="••••••••" class="w-full bg-blue-50 p-4 rounded-xl border border-blue-100 focus:border-blue-500 outline-none" />
        </div>
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 py-4 rounded-xl text-white font-bold transition-all shadow-lg shadow-blue-200">
          Login
        </button>
      </form>
    </div>
  </main>
</DentalLayout>
