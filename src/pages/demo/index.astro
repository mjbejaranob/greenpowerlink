---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="GreenPowerLink | Demo Portal">
  <main class="min-h-screen bg-slate-950 text-slate-100 p-8 md:p-16 max-w-4xl mx-auto">
    <a href="/" class="text-blue-400 hover:text-blue-300 mb-8 inline-block">← Back to Main Site</a>
    <h1 class="text-4xl font-bold mb-8">Professional Demo Portal</h1>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/demo/login" class="p-6 bg-slate-900 border border-slate-700 rounded-xl hover:border-blue-500">Login/Auth</a>
      <a href="/demo/booking" class="p-6 bg-slate-900 border border-slate-700 rounded-xl hover:border-green-500">Booking System</a>
      <a href="/demo/shop" class="p-6 bg-slate-900 border border-slate-700 rounded-xl hover:border-purple-500">E-Commerce</a>
    </div>
  </main>
</Layout>
