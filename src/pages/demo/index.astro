---
import Layout from '../../layouts/Layout.astro';
import { ExternalLink, Stethoscope, Calculator } from 'lucide-astro';

const demos = [
  {
    title: "SmileTech Dental Clinic",
    description: "A comprehensive medical portal featuring patient booking, staff login, and an e-commerce shop for clinical products.",
    href: "/demo/dental",
    icon: Stethoscope,
    color: "blue",
    tags: ["Healthcare", "E-commerce", "Booking"]
  },
  {
    title: "Family Finance Planner",
    description: "A powerful financial tool for tracking income, expenses, assets, and debts with real-time projections and retirement simulations.",
    href: "/demo/finance-planner",
    icon: Calculator,
    color: "green",
    tags: ["FinTech", "Data Visualization", "Planning"]
  }
];
---

<Layout title="Professional Demos | GreenPowerLink">
  <main class="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-green-500/30 flex flex-col">
    <!-- Ambient Glow Background -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] bg-blue-900/20 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-[10%] -right-[10%] w-[30%] h-[30%] bg-green-900/20 blur-[100px] rounded-full"></div>
    </div>

    <div class="relative z-10 p-8 md:p-16 max-w-5xl mx-auto flex-grow w-full">
      <header class="mb-16 text-center md:text-left">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-green-400">Project</span>
          <span class="text-white">Showcase.</span>
        </h1>
        <p class="text-lg text-slate-400 mt-4 max-w-2xl mx-auto md:mx-0">
          Explore interactive demonstrations of high-performance web applications, featuring advanced logic, data visualization, and seamless user experiences.
        </p>
      </header>

      <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {demos.map((demo) => (
          <a href={demo.href} class="group relative p-8 bg-slate-900/50 border border-slate-800 rounded-3xl backdrop-blur-sm hover:bg-slate-800/50 hover:border-slate-600 transition-all duration-300 flex flex-col h-full">
            <div class={`w-14 h-14 mb-8 rounded-2xl bg-${demo.color}-500/10 flex items-center justify-center border border-${demo.color}-500/20 group-hover:scale-110 transition-transform duration-500`}>
              <demo.icon class={`w-7 h-7 text-${demo.color}-500`} />
            </div>
            
            <h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors">{demo.title}</h2>
            <p class="text-slate-400 mb-8 text-sm leading-relaxed flex-grow">{demo.description}</p>
            
            <div class="flex flex-wrap gap-2 mb-8">
              {demo.tags.map(tag => (
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 bg-slate-800 rounded-md text-slate-400">{tag}</span>
              ))}
            </div>

            <div class="flex items-center gap-2 text-sm font-bold tracking-widest uppercase text-slate-500 group-hover:text-white transition-colors mt-auto">
              Launch Demo <ExternalLink class="w-4 h-4" />
            </div>
          </a>
        ))}
      </section>

      <footer class="mt-20 pt-8 border-t border-slate-900 text-center md:text-left">
        <a href="/" class="text-slate-500 hover:text-white transition-colors text-sm font-mono tracking-widest">
          ← RETURN TO HOME
        </a>
      </footer>
    </div>
  </main>
</Layout>
