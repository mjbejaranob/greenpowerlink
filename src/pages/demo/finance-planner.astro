// ═══════════════════════════════════════
// FORECAST
// ═══════════════════════════════════════
let fcNWChart, fcCFChart;
function sliderVal(id) { return parseFloat(document.getElementById('sl-'+id).value); }
function sliderChange(el, key, suffix) {
  const val=parseFloat(el.value);
  document.getElementById('sv-'+key).textContent = suffix==='$'?'$'+val.toLocaleString():val.toFixed(suffix===' yrs'?0:1)+suffix;
  updateTrack(el); renderForecast();
}
function updateTrack(el) {
  const pct=((parseFloat(el.value)-parseFloat(el.min))/(parseFloat(el.max)-parseFloat(el.min)))*100;
  el.style.setProperty('--pct',pct+'%');
}
function setPreset(preset, el) {
  document.querySelectorAll('.stab').forEach(t=>t.classList.remove('active')); el.classList.add('active');
  const P={conservative:{incgrow:1.5,expinfl:3.5,invret:4,propgrow:3,extrasav:0,horizon:20},moderate:{incgrow:3,expinfl:2.5,invret:7,propgrow:5,extrasav:0,horizon:20},optimistic:{incgrow:5,expinfl:2,invret:10,propgrow:7,extrasav:500,horizon:20}};
  const p=P[preset];
  const suffs={incgrow:'%',expinfl:'%',invret:'%',propgrow:'%',extrasav:'$',horizon:' yrs'};
  Object.keys(p).forEach(k=>{
    const sl=document.getElementById('sl-'+k); if(sl) { sl.value=p[k]; updateTrack(sl); }
    const suf=suffs[k], val=p[k];
    const sv = document.getElementById('sv-'+k);
    if(sv) sv.textContent=suf==='$'?'$'+val.toLocaleString():val.toFixed(suf===' yrs'?0:1)+suf;
  });
  renderForecast();
}
function renderForecast() {
  const iG=sliderVal('incgrow')/100, eI=sliderVal('expinfl')/100;
  const iR=sliderVal('invret')/100, pG=sliderVal('propgrow')/100;
  const eS=sliderVal('extrasav'), H=Math.round(sliderVal('horizon'));
  const startYear = new Date().getFullYear();
  const labels=Array.from({length:H+1},(_,i)=>startYear+i);
  const nwArr=[], cfArr=[];
  let prop=DB.assets.filter(a=>['property','investment_prop'].includes(a.type)).reduce((s,x)=>s+x.value,0);
  let inv=DB.assets.filter(a=>!['property','investment_prop'].includes(a.type)).reduce((s,x)=>s+x.value,0);
  let debt=totalDebts(), inc=totalIncome(), exp=totalExpenses()+totalRepayments();
  const mc=totalContribs();
  const plansByYear={};
  DB.plans.forEach(p=>{ plansByYear[p.year]=(plansByYear[p.year]||0)+p.cost; });

  for(let i=0;i<=H;i++){
    const yr=startYear+i, planCost=(plansByYear[yr]||0);
    const cf=inc-exp+eS;
    nwArr.push(Math.round(prop+inv-debt));
    cfArr.push(Math.round(cf-planCost/12));
    prop*=(1+pG);
    inv=inv*(1+iR)+(mc+Math.max(0,cf*0.5))*12;
    debt=Math.max(0,debt-totalRepayments()*12*0.6);
    inc*=(1+iG); exp*=(1+eI);
  }

  setText('fc-5y',fmt(nwArr[Math.min(5,H)]));
  setText('fc-10y',fmt(nwArr[Math.min(10,H)]));
  setText('fc-20y',fmt(nwArr[Math.min(20,H)]));

  if(fcNWChart) fcNWChart.destroy();
  fcNWChart=new Chart(document.getElementById('fc-nw-chart'),{
    type:'line',
    data:{labels,datasets:[{label:'Net Worth',data:nwArr,borderColor:'rgba(88,166,255,1)',backgroundColor:'rgba(88,166,255,0.1)',borderWidth:2.5,pointRadius:0,pointHoverRadius:5,tension:0.4,fill:true}]},
