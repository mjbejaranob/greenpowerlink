function go(page, el) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('screen-' + page).classList.add('active');
  el.classList.add('active');
  if (page === 'home')       renderOverview();
  if (page === 'forecast')   renderForecast();
  if (page === 'retirement') calcRetirement();
  if (page === 'pension') { togglePartner(); calcPension(); }
}

function toggleAdd(id) {
  const el = document.getElementById(id);
  el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

// ═══════════════════════════════════════
// COMPUTED TOTALS
// ═══════════════════════════════════════
const totalIncome    = () => DB.income.reduce((s,x)=>s+x.amount,0);
const totalExpenses  = () => DB.expenses.reduce((s,x)=>s+x.amount,0);
const totalAssets    = () => DB.assets.reduce((s,x)=>s+x.value,0);
const totalDebts     = () => DB.debts.reduce((s,x)=>s+x.balance,0);
const totalRepayments= () => DB.debts.reduce((s,x)=>s+x.repayment,0);
const totalContribs  = () => DB.assets.reduce((s,x)=>s+x.contrib,0);
const netWorth       = () => totalAssets() - totalDebts();
const monthlyCF      = () => totalIncome() - totalExpenses() - totalRepayments();
const passiveIncome  = () => DB.income.filter(x=>['rental','dividends','pension'].includes(x.type)).reduce((s,x)=>s+x.amount,0);

// ═══════════════════════════════════════
// FORMATTING
// ═══════════════════════════════════════
function fmt(v) {
  const a = Math.abs(v);
  const s = a>=1e6 ? '$'+(a/1e6).toFixed(2)+'M' : a>=1e3 ? '$'+Math.round(a/1000)+'k' : '$'+Math.round(a).toLocaleString();
  return v < 0 ? '-'+s : s;
}
const fmtFull = v => (v<0?'-$':'$')+Math.abs(Math.round(v)).toLocaleString();

// ═══════════════════════════════════════
// GLOBAL SIDEBAR UPDATE
// ═══════════════════════════════════════
function updateGlobals() {
  const inc=totalIncome(), exp=totalExpenses()+totalRepayments(), cf=inc-exp, nw=netWorth();
  setText('ss-income', fmtFull(inc));
  setText('ss-expenses', fmtFull(exp));
  const cfEl = document.getElementById('ss-cashflow');
  cfEl.textContent = fmtFull(cf);
  cfEl.className = 'ss-val '+(cf>=0?'pos':'neg');
  setText('ss-networth', fmt(nw));
}

function setText(id, v) { const e=document.getElementById(id); if(e) e.textContent=v; }

