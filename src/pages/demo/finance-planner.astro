let retChart;
function calcRetirement() {
  const age=parseInt(v('ret-age'))||40, retAge=parseInt(v('ret-target-age'))||65;
  const lifeExp=parseInt(v('ret-life'))||90, needMo=parseFloat(v('ret-need'))||5000;
  const retReturn=parseFloat(v('ret-return'))/100||0.05, retInfl=parseFloat(v('ret-inflation'))/100||0.025;
  const pension=parseFloat(v('ret-pension'))||0, passive=parseFloat(v('ret-passive'))||0;
  const yrsToRet=Math.max(0,retAge-age), yrsInRet=Math.max(1,lifeExp-retAge);

  setText('ret-years-left',yrsToRet);

  const superNow=DB.assets.filter(a=>a.type==='super').reduce((s,x)=>s+x.value,0);
  const superC=DB.assets.filter(a=>a.type==='super').reduce((s,x)=>s+x.contrib,0);
  const safeR=retReturn||0.001;
  const fvFactor=yrsToRet>0?((Math.pow(1+safeR,yrsToRet)-1)/safeR):yrsToRet;
  const superAt=superNow*Math.pow(1+safeR,yrsToRet)+superC*12*fvFactor;

  const propNow=DB.assets.filter(a=>['property','investment_prop'].includes(a.type)).reduce((s,x)=>s+x.value,0);
  const propAt=propNow*Math.pow(1.05,yrsToRet);
  const invNow=DB.assets.filter(a=>!['property','investment_prop'].includes(a.type)&&a.type!=='super').reduce((s,x)=>s+x.value,0);
  const invC=DB.assets.filter(a=>!['property','investment_prop'].includes(a.type)&&a.type!=='super').reduce((s,x)=>s+x.contrib,0);
  const invAt=invNow*Math.pow(1+safeR,yrsToRet)+invC*12*fvFactor;
  const debtAt=Math.max(0,totalDebts()-totalRepayments()*yrsToRet*12);
  const liquidAt=superAt+invAt;
  const totalAt=liquidAt+propAt-debtAt;
  const drawableAt=liquidAt;

  setText('ret-super-proj',fmt(superAt));
  setText('ret-assets-proj',fmt(totalAt));

  const labels=[], saldos=[];
  let fund=drawableAt, lastAge=retAge;
  for(let yr=0;yr<=yrsInRet;yr++){
    const currentAge=retAge+yr;
    labels.push('Age '+currentAge);
    const needReal=needMo*Math.pow(1+retInfl,yr);
    const passiveReal=(pension+passive)*Math.pow(1+retInfl,yr);
    const netWithdrawal=Math.max(0, needReal - passiveReal) * 12;
    fund = fund * (1 + safeR) - netWithdrawal;
    saldos.push(Math.round(fund));
    if(fund > 0) lastAge=currentAge;
    if(fund <= 0) { fund=0; if(yr < yrsInRet) saldos[saldos.length-1]=0; }
  }

  const solvent=saldos[saldos.length-1]>0;
  const lastAgeEl=document.getElementById('ret-last-age');
  if(lastAgeEl) {
    lastAgeEl.textContent=solvent?'Age '+lifeExp+'+ ✓':'Age '+lastAge;
    lastAgeEl.style.color=solvent?'var(--mint)':'var(--coral)';
  }

  if(retChart) retChart.destroy();
  retChart=new Chart(document.getElementById('ret-chart'),{
    type:'line',
    data:{labels,datasets:[{label:'Funds',data:saldos,borderColor:solvent?'rgba(63,185,80,1)':'rgba(248,81,73,1)',backgroundColor:solvent?'rgba(63,185,80,0.1)':'rgba(248,81,73,0.1)',borderWidth:2.5,pointRadius:0,tension:0.4,fill:true}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}}},scales:{x:{grid:{display:false},ticks:{color:'#8b949e',maxTicksLimit:10}},y:{grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'#8b949e',callback:v=>fmt(v)}}}}
  });

  const alerts=[];
  if(!solvent) alerts.push({t:'coral',m:`<strong>⚠️ Funds run out at age ${lastAge}.</strong> You may outlive your savings.`});
  else alerts.push({t:'mint',m:`<strong>✅ Looking good!</strong> Funds projected to last through age ${lifeExp}.`});
  const alEl = document.getElementById('ret-alerts');
  if(alEl) alEl.innerHTML=alerts.map(a=>`<div class="alert alert-${a.t}">${a.m}</div>`).join('');
}

