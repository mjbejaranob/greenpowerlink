---
// Family Finance Planner - Standalone Demo Page
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Family Finance Planner | Demo</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
<style is:global>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --ink: #0d1117; --ink2: #161b22; --ink3: #21262d; --ink4: #2d333b;
  --line: rgba(255,255,255,0.08); --line2: rgba(255,255,255,0.04);
  --sky: #58a6ff; --mint: #3fb950; --coral: #f85149; --amber: #d29922;
  --lavender: #bc8cff; --cyan: #39c5cf;
  --text: #e6edf3; --text2: #8b949e; --text3: #484f58;
  --radius: 10px; --ff: 'Sora', sans-serif; --mono: 'JetBrains Mono', monospace;
}
html { background: var(--ink); color: var(--text); font-family: var(--ff); font-size: 14px; }
body { display: flex; min-height: 100vh; }

/* ── SIDEBAR ── */
#sidebar {
  width: 235px; min-height: 100vh; background: var(--ink2);
  border-right: 1px solid var(--line); position: fixed; top:0; left:0; bottom:0;
  display: flex; flex-direction: column; z-index: 20; overflow-y: auto;
}
.brand { padding: 1.4rem 1.5rem; border-bottom: 1px solid var(--line); }
.brand-name { font-size: 0.95rem; font-weight: 700; letter-spacing: -0.02em; }
.brand-sub { font-size: 0.66rem; color: var(--text2); margin-top: 0.2rem; font-family: var(--mono); }
.nav-group { padding: 1rem 0.75rem 0.3rem; font-size: 0.6rem; color: var(--text3); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
.nav-item {
  display: flex; align-items: center; gap: 0.6rem; margin: 0.08rem 0.5rem;
  padding: 0.5rem 0.75rem; border-radius: 8px; cursor: pointer;
  color: var(--text2); font-size: 0.81rem; font-weight: 500;
  transition: all 0.15s; border: 1px solid transparent;
}
.nav-item:hover { color: var(--text); background: var(--ink3); }
.nav-item.active { color: var(--sky); background: rgba(88,166,255,0.1); border-color: rgba(88,166,255,0.2); }
.nav-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.5; flex-shrink: 0; }
.nav-item.active .nav-dot { opacity: 1; }
.sidebar-summary { margin-top: auto; border-top: 1px solid var(--line); padding: 0.9rem 1rem; }
.ss-title { font-size: 0.6rem; color: var(--text3); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.5rem; }
.ss-row { display: flex; justify-content: space-between; align-items: center; padding: 0.28rem 0; font-size: 0.73rem; }
.ss-label { color: var(--text2); }
.ss-val { font-family: var(--mono); font-weight: 500; }
.ss-val.pos { color: var(--mint); } .ss-val.neg { color: var(--coral); }

/* ── MAIN ── */
#main { margin-left: 235px; flex: 1; padding: 2rem 2.5rem 5rem; }
.screen { display: none; animation: rise 0.22s ease; }
.screen.active { display: block; }
@keyframes rise { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

/* ── PAGE HEADER ── */
.ph { margin-bottom: 1.75rem; display: flex; justify-content: space-between; align-items: flex-start; }
.ph-left h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.03em; }
.ph-left p { color: var(--text2); font-size: 0.81rem; margin-top: 0.3rem; }
.ph-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }

/* ── CARDS ── */
.card { background: var(--ink2); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; }
.card-title { font-size: 0.7rem; color: var(--text2); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem; }
.grid { display: grid; gap: 1rem; }
.g2 { grid-template-columns: 1fr 1fr; }
.g3 { grid-template-columns: 1fr 1fr 1fr; }
.g4 { grid-template-columns: repeat(4,1fr); }
.g12 { grid-template-columns: 1fr 2fr; }
.g21 { grid-template-columns: 2fr 1fr; }

/* ── KPI ── */
.kpi-grid { display: grid; gap: 0.75rem; margin-bottom: 1.25rem; }
.kpi { background: var(--ink2); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.1rem; }
.kpi-label { font-size: 0.67rem; color: var(--text2); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.4rem; }
.kpi-val { font-size: 1.45rem; font-family: var(--mono); font-weight: 500; letter-spacing: -0.03em; }
.kpi-sub { font-size: 0.69rem; color: var(--text2); margin-top: 0.2rem; }
.kpi.sky { border-top: 2px solid var(--sky); }
.kpi.mint { border-top: 2px solid var(--mint); }
.kpi.coral { border-top: 2px solid var(--coral); }
.kpi.amber { border-top: 2px solid var(--amber); }
.kpi.lavender { border-top: 2px solid var(--lavender); }
.kpi.cyan { border-top: 2px solid var(--cyan); }

/* ── FORMS ── */
.form-row { display: grid; gap: 0.7rem; margin-bottom: 0.7rem; }
.fr2 { grid-template-columns: 1fr 1fr; }
.fr3 { grid-template-columns: 1fr 1fr 1fr; }
.fr4 { grid-template-columns: 1fr 1fr 1fr 1fr; }
.field { position: relative; }
label { font-size: 0.73rem; color: var(--text2); font-weight: 500; display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.32rem; }
.tip-btn { background: none; border: 1px solid var(--text3); color: var(--text3); border-radius: 50%; width: 14px; height: 14px; font-size: 0.6rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.15s; font-family: var(--ff); }
.tip-btn:hover { border-color: var(--sky); color: var(--sky); }
.label-row{display:flex;align-items:center;gap:.3rem;margin-bottom:.3rem}
.label-text{font-size:.73rem;color:var(--text2);font-weight:500}
input[type=text], input[type=number], select, textarea {
  width: 100%; background: var(--ink3); border: 1px solid var(--line);
  border-radius: 7px; padding: 0.52rem 0.72rem; color: var(--text);
  font-family: var(--ff); font-size: 0.84rem; outline: none; transition: border 0.15s;
}
input[type=text]:focus, input[type=number]:focus, select:focus { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(88,166,255,0.1); }
select option { background: var(--ink3); }
input[type=number] { font-family: var(--mono); }

/* ── BUTTONS ── */
.btn { padding: 0.5rem 1rem; border-radius: 7px; border: 1px solid var(--line); background: var(--ink3); color: var(--text); cursor: pointer; font-family: var(--ff); font-size: 0.8rem; font-weight: 500; transition: all 0.15s; }
.btn:hover { background: var(--ink4); border-color: rgba(255,255,255,0.15); }
.btn-sky { background: var(--sky); border-color: var(--sky); color: #000; }
.btn-sky:hover { background: #79bcff; }
.btn-mint { background: rgba(63,185,80,0.15); border-color: var(--mint); color: var(--mint); }
.btn-mint:hover { background: rgba(63,185,80,0.25); }
.btn-coral { background: rgba(248,81,73,0.1); border-color: var(--coral); color: var(--coral); }
.btn-coral:hover { background: rgba(248,81,73,0.2); }
.btn-amber { background: rgba(210,153,34,0.1); border-color: var(--amber); color: var(--amber); }
.btn-sm { padding: 0.32rem 0.7rem; font-size: 0.73rem; }

/* ── ITEM LIST ── */
.item-list { display: flex; flex-direction: column; gap: 0.45rem; }
.item-row {
  display: flex; align-items: center; gap: 0.7rem;
  background: var(--ink3); border: 1px solid var(--line); border-radius: 8px; padding: 0.65rem 0.9rem;
  transition: border-color 0.15s;
}
.item-row:hover { border-color: rgba(255,255,255,0.13); }
.item-icon { font-size: 1.05rem; flex-shrink: 0; }
.item-info { flex: 1; min-width: 0; }
.item-name { font-size: 0.84rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.item-meta { font-size: 0.7rem; color: var(--text2); margin-top: 0.08rem; }
.item-amount { font-family: var(--mono); font-size: 0.88rem; font-weight: 500; flex-shrink: 0; }
.item-btns { display: flex; gap: 0.25rem; flex-shrink: 0; }
.item-btn { background: none; border: none; cursor: pointer; color: var(--text3); font-size: 0.85rem; padding: 0.2rem 0.4rem; border-radius: 4px; transition: all 0.15s; }
.item-btn.edit:hover { color: var(--sky); background: rgba(88,166,255,0.1); }
.item-btn.del:hover { color: var(--coral); background: rgba(248,81,73,0.1); }

/* ── ADD/EDIT FORM ── */
.add-form { background: var(--ink3); border: 1px dashed var(--line); border-radius: var(--radius); padding: 1.1rem; margin-top: 0.75rem; }
.add-form-title { font-size: 0.72rem; color: var(--text2); font-weight: 600; margin-bottom: 0.85rem; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.5rem; }
.edit-mode-badge { background: rgba(88,166,255,0.15); color: var(--sky); border-radius: 4px; padding: 0.1rem 0.4rem; font-size: 0.65rem; }

/* ── SLIDERS ── */
.slider-block { margin-bottom: 1rem; }
.slider-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem; }
.slider-lbl { font-size: 0.79rem; color: var(--text); font-weight: 500; display: flex; align-items: center; gap: 0.4rem; }
.slider-val { font-family: var(--mono); font-size: 0.84rem; color: var(--sky); font-weight: 500; min-width: 55px; text-align: right; }
input[type=range] {
  width: 100%; height: 4px; border-radius: 100px; outline: none; cursor: pointer;
  -webkit-appearance: none; appearance: none; border: none;
  background: linear-gradient(to right, var(--sky) var(--pct,50%), var(--ink4) var(--pct,50%));
}
input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%;
  background: var(--sky); border: 2px solid var(--ink2); cursor: pointer;
  box-shadow: 0 0 0 3px rgba(88,166,255,0.2);
}

/* ── PROGRESS BAR ── */
.pbar-track { height: 6px; background: var(--ink4); border-radius: 100px; overflow: hidden; }
.pbar-fill { height: 100%; border-radius: 100px; transition: width 0.5s ease; }

/* ── SCENARIO TABS ── */
.stabs { display: flex; gap: 0.4rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
.stab { padding: 0.4rem 0.95rem; border-radius: 100px; border: 1px solid var(--line); background: var(--ink2); color: var(--text2); cursor: pointer; font-size: 0.78rem; font-weight: 500; transition: all 0.15s; }
.stab:hover { color: var(--text); border-color: rgba(255,255,255,0.15); }
.stab.active { background: var(--sky); border-color: var(--sky); color: #000; font-weight: 600; }

/* ── BADGES ── */
.badge { display: inline-block; padding: 0.12rem 0.45rem; border-radius: 4px; font-size: 0.66rem; font-weight: 600; }
.badge-sky { background: rgba(88,166,255,0.15); color: var(--sky); }
.badge-mint { background: rgba(63,185,80,0.15); color: var(--mint); }
.badge-coral { background: rgba(248,81,73,0.15); color: var(--coral); }
.badge-amber { background: rgba(210,153,34,0.15); color: var(--amber); }

/* ── ALERTS ── */
.alert { padding: 0.75rem 0.9rem; border-radius: 8px; font-size: 0.79rem; display: flex; gap: 0.55rem; margin-bottom: 0.55rem; line-height: 1.5; }
.alert-mint { background: rgba(63,185,80,0.08); border-left: 3px solid var(--mint); }
.alert-coral { background: rgba(248,81,73,0.08); border-left: 3px solid var(--coral); }
.alert-amber { background: rgba(210,153,34,0.08); border-left: 3px solid var(--amber); }
.alert-sky { background: rgba(88,166,255,0.08); border-left: 3px solid var(--sky); }

/* ── TOOLTIP POPUP ── */
#tooltip-overlay {
  display: none; position: fixed; inset: 0; z-index: 1000;
  background: rgba(0,0,0,0.6); backdrop-filter: blur(3px);
  align-items: center; justify-content: center;
}
#tooltip-overlay.show { display: flex; }
.tooltip-box {
  background: var(--ink2); border: 1px solid var(--line); border-radius: 14px;
  padding: 1.75rem; max-width: 420px; width: 90%; position: relative;
  animation: popIn 0.2s ease;
}
@keyframes popIn { from { opacity:0; transform:scale(0.94); } to { opacity:1; transform:scale(1); } }
.tooltip-icon { font-size: 2rem; margin-bottom: 0.75rem; }
.tooltip-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
.tooltip-body { font-size: 0.82rem; color: var(--text2); line-height: 1.7; }
.tooltip-body strong { color: var(--text); }
.tooltip-body .example { background: var(--ink3); border-radius: 6px; padding: 0.6rem 0.8rem; margin-top: 0.6rem; font-family: var(--mono); font-size: 0.75rem; color: var(--sky); }
.tooltip-close { position: absolute; top: 1rem; right: 1rem; background: none; border: 1px solid var(--line); color: var(--text2); border-radius: 6px; padding: 0.25rem 0.6rem; cursor: pointer; font-size: 0.75rem; }
.tooltip-close:hover { color: var(--text); border-color: rgba(255,255,255,0.2); }

/* ── MODAL (EDIT) ── */
#modal-overlay {
  display: none; position: fixed; inset: 0; z-index: 900;
  background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
  align-items: center; justify-content: center;
}
#modal-overlay.show { display: flex; }
.modal-box {
  background: var(--ink2); border: 1px solid var(--line); border-radius: 14px;
  padding: 1.75rem; max-width: 580px; width: 94%; position: relative;
  animation: popIn 0.2s ease; max-height: 90vh; overflow-y: auto;
}
.modal-title { font-size: 1rem; font-weight: 700; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
.modal-close { position: absolute; top: 1rem; right: 1rem; background: none; border: 1px solid var(--line); color: var(--text2); border-radius: 6px; padding: 0.25rem 0.6rem; cursor: pointer; font-size: 0.75rem; }
.modal-close:hover { color: var(--text); border-color: rgba(255,255,255,0.2); }

/* ── TOAST ── */
#toast { position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%) translateY(100px); background: var(--ink2); border: 1px solid var(--line); border-radius: 100px; padding: 0.6rem 1.2rem; font-size: 0.8rem; z-index: 2000; transition: transform 0.3s ease; white-space: nowrap; }
#toast.show { transform: translateX(-50%) translateY(0); }

/* ── GUIDE PAGE ── */
.guide-section { margin-bottom: 2rem; }
.guide-section h2 { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; }
.guide-step { display: flex; gap: 1rem; margin-bottom: 1rem; align-items: flex-start; }
.guide-num { width: 28px; height: 28px; border-radius: 50%; background: rgba(88,166,255,0.15); color: var(--sky); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.1rem; }
.guide-step-body h3 { font-size: 0.88rem; font-weight: 600; margin-bottom: 0.25rem; }
.guide-step-body p { font-size: 0.8rem; color: var(--text2); line-height: 1.6; }
.guide-tip { background: rgba(88,166,255,0.06); border: 1px solid rgba(88,166,255,0.15); border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.79rem; color: var(--text2); line-height: 1.6; margin-bottom: 0.75rem; }
.guide-tip strong { color: var(--sky); }
.guide-faq-q { font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; }
.guide-faq-a { font-size: 0.8rem; color: var(--text2); line-height: 1.6; margin-bottom: 1rem; padding-left: 1rem; border-left: 2px solid var(--line); }

/* ── CHART WRAP ── */
.chart-wrap { position: relative; }

/* ── UTILS ── */
.flex { display: flex; } .jb { justify-content: space-between; } .ac { align-items: center; }
.gap1 { gap: 1rem; } .gap05 { gap: 0.5rem; }
.mt1 { margin-top: 1rem; } .mt05 { margin-top: 0.5rem; } .mb1 { margin-bottom: 1rem; } .mb2 { margin-bottom: 2rem; }
.fw6 { font-weight: 600; } .mono { font-family: var(--mono); }
.col2 { color: var(--text2); } .col-mint { color: var(--mint); } .col-coral { color: var(--coral); }
.col-sky { color: var(--sky); } .col-amber { color: var(--amber); }
.fs12 { font-size: 0.85rem; } .fs11 { font-size: 0.78rem; } .text-right { text-align: right; }
.divider { height: 1px; background: var(--line); margin: 1rem 0; }
.empty-state { text-align: center; padding: 1.75rem; color: var(--text3); font-size: 0.79rem; }

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE DESIGN — Mobile First
   ═══════════════════════════════════════════════════════════════ */

/* Mobile: base styles above already work for mobile (single column) */

/* Tablet: 768px and up */
@media (max-width: 1024px) {
  #sidebar {
    width: 200px;
  }
  #main {
    margin-left: 200px;
    padding: 1.5rem 1.5rem 4rem;
  }
  .g2, .g3, .g4, .g12, .g21, .g13 {
    grid-template-columns: 1fr !important;
  }
  .fr2, .fr3, .fr4 {
    grid-template-columns: 1fr !important;
  }
  .ph {
    flex-direction: column;
    align-items: flex-start;
  }
  .ph-actions {
    width: 100%;
    justify-content: flex-start;
  }
  .kpi-grid {
    grid-template-columns: 1fr 1fr !important;
  }
}

/* Mobile: 640px and down */
@media (max-width: 640px) {
  body {
    flex-direction: column;
  }
  
  #sidebar {
    width: 100%;
    min-height: auto;
    position: static;
    border-right: none;
    border-bottom: 1px solid var(--line);
  }
  
  #main {
    margin-left: 0;
    padding: 1rem 1rem 3rem;
  }
  
  .brand {
    padding: 1rem;
  }
  
  .nav-group {
    display: none; /* Hide section headers on mobile */
  }
  
  .nav-item {
    margin: 0.05rem 0.3rem;
    padding: 0.4rem 0.6rem;
    font-size: 0.75rem;
  }
  
  .sidebar-summary {
    padding: 0.7rem 0.8rem;
  }
  
  .ss-row {
    font-size: 0.68rem;
    padding: 0.2rem 0;
  }
  
  .ph h1 {
    font-size: 1.2rem;
  }
  
  .ph p {
    font-size: 0.75rem;
  }
  
  .card {
    padding: 1rem;
  }
  
  .card-title {
    font-size: 0.65rem;
    margin-bottom: 0.7rem;
  }
  
  .kpi {
    padding: 0.7rem 0.85rem;
  }
  
  .kpi-label {
    font-size: 0.62rem;
  }
  
  .kpi-val {
    font-size: 1.2rem;
  }
  
  .kpi-sub {
    font-size: 0.64rem;
  }
  
  .kpi-grid {
    grid-template-columns: 1fr !important;
  }
  
  .item-row {
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  
  .item-info {
    flex-basis: 100%;
  }
  
  .item-amount {
    font-size: 0.82rem;
  }
  
  .btn {
    padding: 0.42rem 0.75rem;
    font-size: 0.75rem;
  }
  
  .btn-sm {
    padding: 0.28rem 0.55rem;
    font-size: 0.68rem;
  }
  
  .modal-box {
    width: 98%;
    padding: 1.2rem;
    max-height: 95vh;
  }
  
  .tt-box {
    width: 95%;
    padding: 1.2rem;
  }
  
  .alert {
    padding: 0.6rem 0.7rem;
    font-size: 0.74rem;
  }
  
  .guide-step {
    flex-direction: column;
  }
  
  .guide-num {
    width: 100%;
    height: auto;
    padding: 0.3rem;
  }
  
  /* Pension screen mobile tweaks */
  #pen-banner {
    flex-direction: column;
    align-items: flex-start;
  }
  
  #pen-banner-icon {
    font-size: 2rem;
  }
  
  #pen-banner-amount {
    width: 100%;
    text-align: left;
    margin-top: 0.5rem;
  }
  
  /* Stack forecast sliders vertically on mobile */
  .slider-block {
    margin-bottom: 0.7rem;
  }
  
  .slider-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }
  
  .slider-val {
    min-width: auto;
  }
}

/* Extra small mobile: 400px and down */
@media (max-width: 400px) {
  html {
    font-size: 13px;
  }
  
  #main {
    padding: 0.8rem 0.8rem 2.5rem;
  }
  
  .card {
    padding: 0.8rem;
  }
  
  .ph-actions {
    flex-wrap: wrap;
  }
  
  .stabs {
    flex-direction: column;
  }
  
  .stab {
    width: 100%;
    text-align: center;
  }
}

/* Tablet landscape and desktop: restore multi-column when space allows */
@media (min-width: 1025px) {
  /* Grid layouts work as defined in base CSS */
}

/* Print styles */
@media print {
  #sidebar {
    display: none;
  }
  
  #main {
    margin-left: 0;
  }
  
  .screen {
    display: block !important;
  }
  
  .ph-actions {
    display: none;
  }
  
  .chart-wrap {
    page-break-inside: avoid;
  }
}
