function tip(key) {
  const t = TIPS[key]; if (!t) return;
  document.getElementById('tt-icon').textContent = t.icon;
  document.getElementById('tt-title').textContent = t.title;
  document.getElementById('tt-body').innerHTML = t.body;
  document.getElementById('tooltip-overlay').classList.add('show');
}
function closeTooltip(e) {
  if (!e || e.target === document.getElementById('tooltip-overlay')) {
    document.getElementById('tooltip-overlay').classList.remove('show');
  }
}

