function addGoal() {
  const name=v('gl-name'), target=parseFloat(v('gl-target')), saved=parseFloat(v('gl-saved'))||0;
  const dateStr=v('gl-date'), priority=v('gl-priority');
  if(!name||!target||!dateStr) { flash('gl-name'); return; }

  const months = parseTargetDateToMonths(dateStr);
  const monthly = months > 0 ? (target - saved) / months : 0;

  DB.goals.push({id:uid(),name,target,saved,monthly,date:dateStr,priority});
  clearIds(['gl-name','gl-target','gl-saved','gl-date']);
  renderGoals(); toggleAdd('goal-add'); toast('✓ Goal added ('+fmtFull(monthly)+'/mo)');
}

function parseTargetDateToMonths(dateStr) {
  const target = new Date(dateStr);
  const now = new Date();
  const diff = (target.getFullYear() - now.getFullYear()) * 12 + (target.getMonth() - now.getMonth());
  return Math.max(1, diff);
}
function renderGoals() {
  const list=document.getElementById('goal-list');
  if(!DB.goals.length){ list.innerHTML=emptyState('No goals yet. Add savings targets above.'); return; }
  const pColors={high:'var(--coral)',medium:'var(--amber)',low:'var(--mint)'};
  list.innerHTML=DB.goals.map(g=>{
    const pct=Math.min(100,Math.round(g.saved/g.target*100));
    const monthsLeft=g.monthly>0?Math.ceil((g.target-g.saved)/g.monthly):'—';
    const clr=pColors[g.priority];
    return `<div style="padding:0.8rem;background:var(--ink3);border-radius:8px;margin-bottom:0.55rem;border:1px solid var(--line)">
      <div class="flex jb ac" style="margin-bottom:0.45rem">
        <div><span class="fs12 fw6">${esc(g.name)}</span><span class="badge badge-${g.priority==='high'?'coral':g.priority==='medium'?'amber':'mint'}" style="margin-left:0.4rem">${g.priority}</span>${g.date?`<span class="col2 fs11" style="margin-left:0.5rem">· ${esc(g.date)}</span>`:''}</div>
        <div class="flex ac gap05">
          <span class="mono fs12" style="color:${clr}">${fmtFull(g.saved)} / ${fmtFull(g.target)}</span>
          <button type="button" class="item-btn edit" onclick="openEdit('goal','${g.id}')">✏️</button>
          <button type="button" class="item-btn del" onclick="deleteItem('goal','${g.id}')">✕</button>
