function togglePartner() {
  const status = gv('pen-status');
  const partnerBlock = document.getElementById('pen-partner-block');
  if (partnerBlock) partnerBlock.style.display = status === 'couple' ? 'block' : 'none';
}

function calcPension() {
  const age = parseInt(gv('pen-age')) || 60;
  const status = gv('pen-status');
  const homeowner = gv('pen-homeowner') === 'yes';
  const isSingle = status === 'single';
  
  const agePass = age >= PEN.qualifying_age;
  setEl('pen-age-icon', agePass ? '✅' : '❌');
  styleCard('pen-age-card', agePass ? 'mint' : 'coral');

  const assessableAssets = DB.assets.filter(a => a.type !== 'property' && !(a.type === 'super' && age < 60)).reduce((s, x) => s + x.value, 0);
  const assetLimit = homeowner ? (isSingle ? PEN.single_asset_home : PEN.couple_asset_home) : (isSingle ? PEN.single_asset_nohome : PEN.couple_asset_nohome);
  const assetCutoff = homeowner ? (isSingle ? PEN.single_asset_cutoff_home : PEN.couple_asset_cutoff_home) : (isSingle ? PEN.single_asset_cutoff_nohome : PEN.couple_asset_cutoff_nohome);
  const assetPass = assessableAssets <= assetCutoff;
  styleCard('pen-assets-card', assetPass ? 'mint' : 'coral');

  // Simplified calculation for demo purposes
  const payFn = agePass && assetPass ? Math.max(0, (isSingle ? PEN.single_max_fn : PEN.couple_max_fn*2) - Math.max(0, assessableAssets-assetLimit)*PEN.asset_taper) : 0;
  setEl('pen-fortnight', payFn > 0 ? fmtFn(payFn) : '—');
}

function gv(id) { return document.getElementById(id)?.value || ''; }
function setEl(id, txt) { const e = document.getElementById(id); if (e) e.textContent = txt; }
function setHTML(id, html) { const e = document.getElementById(id); if (e) e.innerHTML = html; }
function fmtFn(v) { return '$' + Math.abs(v).toFixed(2); }
function styleCard(id, color) { const e = document.getElementById(id); if (e) e.style.borderTop = `2px solid var(--${color})`; }

