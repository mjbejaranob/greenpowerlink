function openEdit(type, id) {
  const mapKey = { income:'income', expense:'expenses', asset:'assets', debt:'debts', goal:'goals', plan:'plans' };
  const item = DB[mapKey[type]].find(x => x.id === id);
  if (!item) return;
  editContext = { type, id };
  document.getElementById('modal-title').innerHTML = `✏️ Edit ${type.charAt(0).toUpperCase()+type.slice(1)} <span class="badge badge-sky" style="font-size:0.7rem">editing</span>`;
  document.getElementById('modal-body').innerHTML = EDIT_TEMPLATES[type](item);
  document.getElementById('modal-overlay').classList.add('show');
}

function saveEdit() {
  if (!editContext) return;
  SAVE_FUNCS[editContext.type]();
  closeModal();
  toast('✓ Entry updated');
}

function findEdit() {
  const mapKey = { income:'income', expense:'expenses', asset:'assets', debt:'debts', goal:'goals', plan:'plans' };
  return DB[mapKey[editContext.type]].find(x => x.id === editContext.id);
}

function closeModal(e) {
  if (!e || e.target === document.getElementById('modal-overlay')) {
    document.getElementById('modal-overlay').classList.remove('show');
    editContext = null;
  }
}

// ═══════════════════════════════════════
// SAVE / LOAD PLAN
// ═══════════════════════════════════════
async function savePlan() {
  const json = JSON.stringify({ 
    version: 3, 
    savedAt: new Date().toISOString(), 
    ...DB 
  }, null, 2);
  
  if ('showSaveFilePicker' in window) {
    try {
      const opts = {
        suggestedName: 'family-finance-plan.json',
        types: [{
          description: 'Finance Plan JSON',
          accept: { 'application/json': ['.json'] }
        }]
      };
      const handle = await window.showSaveFilePicker(opts);
      const writable = await handle.createWritable();
      await writable.write(json);
      await writable.close();
      toast('💾 Plan saved to ' + handle.name);
      return;
    } catch (err) {
      if (err.name !== 'AbortError') console.error('Save error:', err);
    }
  }
  
  const blob = new Blob([json], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'family-finance-plan.json';
  a.click();
  URL.revokeObjectURL(a.href);
  toast('💾 Plan downloaded to your Downloads folder');
}

async function loadPlan(input) {
  if (!input) {
    if ('showOpenFilePicker' in window) {
      try {
        const [handle] = await window.showOpenFilePicker({
          types: [{
            description: 'Finance Plan JSON',
            accept: { 'application/json': ['.json'] }
          }],
          multiple: false
        });
        const file = await handle.getFile();
        const text = await file.text();
        loadPlanData(text, handle.name);
        return;
      } catch (err) {
        if (err.name !== 'AbortError') {
          console.error('Load error:', err);
          toast('❌ Error opening file picker');
        }
        return;
      }
    }
    document.getElementById('load-file').click();
    return;
  }
  
  const file = input.files[0]; 
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    loadPlanData(e.target.result, file.name);
  };
  reader.readAsText(file);
  input.value = '';
}

function loadPlanData(jsonText, filename) {
  try {
    const data = JSON.parse(jsonText);
    ['income','expenses','assets','debts','goals','plans'].forEach(k => {
      if (data[k]) DB[k] = data[k];
    });
    renderIncome(); renderExpenses(); renderAssets();
    renderDebts(); renderGoals(); renderPlans();
    updateGlobals(); renderOverview();
    toast('📂 ' + filename + ' loaded successfully');
  } catch (err) {
    console.error('Parse error:', err);
    toast('❌ Error loading file — check it\'s a valid JSON plan');
  }
}

