---
import DentalLayout from '../../layouts/DentalLayout.astro';

const products = [
  { name: 'Sonic Pro Brush', price: '$129.00', desc: 'Advanced sonic technology.', img: 'https://images.unsplash.com/photo-1606825203362-e613b28b7e23?q=80&w=400&h=300' },
  { name: 'Whitening System', price: '$89.00', desc: 'Professional clinical results.', img: 'https://images.unsplash.com/photo-1571772996211-2f02c9727623?q=80&w=400&h=300' },
  { name: 'Water Flosser', price: '$65.00', desc: 'Deep cleaning irrigation.', img: 'https://images.unsplash.com/photo-1628452968032-473d09d29efd?q=80&w=400&h=300' },
  { name: 'Fluoride Rinse', price: '$15.00', desc: 'Enamel strengthening.', img: 'https://images.unsplash.com/photo-1612548408800-47b1c312b952?q=80&w=400&h=300' },
  { name: 'Ortho Wax', price: '$8.00', desc: 'Comfort for braces.', img: 'https://images.unsplash.com/photo-1609910237300-8334ca6a9a7c?q=80&w=400&h=300' },
  { name: 'Interdental Brush', price: '$12.00', desc: 'Precise cleaning.', img: 'https://images.unsplash.com/photo-1598282397750-6111f18104ee?q=80&w=400&h=300' },
  { name: 'Electric Flosser', price: '$45.00', desc: 'Battery operated ease.', img: 'https://images.unsplash.com/photo-1588776814546-1ff5372af6a7?q=80&w=400&h=300' },
  { name: 'Tongue Scraper', price: '$10.00', desc: 'Fresh breath control.', img: 'https://images.unsplash.com/photo-1600057468702-86926972049d?q=80&w=400&h=300' },
  { name: 'Night Guard', price: '$99.00', desc: 'Sleep comfort & protection.', img: 'https://images.unsplash.com/photo-1599700367341-942df5fc3d64?q=80&w=400&h=300' },
  { name: 'Travel Kit', price: '$25.00', desc: 'Complete on-the-go care.', img: 'https://images.unsplash.com/photo-1583947215259-38e31be0b51f?q=80&w=400&h=300' },
];
---

<DentalLayout title="SmileTech Dental | Shop">
  <main class="min-h-screen p-8 md:p-16 max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-12">
      <a href="/demo" class="text-blue-600 font-bold hover:underline">← Back</a>
      <h1 class="text-3xl font-bold text-blue-900">Dental Store</h1>
      <a href="/" class="text-teal-600 font-bold hover:underline">Home Site</a>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {products.map((p) => (
        <div class="bg-white p-6 rounded-3xl border border-blue-100 shadow-sm transition-transform hover:scale-105">
          <img src={p.img} alt={p.name} class="w-full h-40 object-cover rounded-2xl mb-4" />
          <h2 class="font-bold text-lg text-slate-900">{p.name}</h2>
          <p class="text-slate-500 text-sm mb-4">{p.desc}</p>
          <div class="flex justify-between items-center">
            <span class="font-bold text-blue-700">{p.price}</span>
            <button onclick="alert('Payment Simulation: Processing Secure Checkout...')" class="px-4 py-2 bg-blue-600 text-white rounded-full text-sm hover:bg-blue-700 transition-colors">Add to Cart</button>
          </div>
        </div>
      ))}
    </div>
  </main>
</DentalLayout>
