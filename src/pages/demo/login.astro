---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="SmileTech Dental | Staff Login">
  <main class="min-h-screen bg-slate-950 text-slate-100 p-8 flex items-center justify-center">
    <div class="w-full max-w-md bg-slate-900 p-8 rounded-2xl border border-slate-700">
      <h1 class="text-2xl font-bold mb-6 text-center text-blue-400">Staff Portal</h1>
      <form class="space-y-4">
        <input type="text" placeholder="Username" class="w-full bg-slate-950 p-3 rounded border border-slate-700" />
        <input type="password" placeholder="Password" class="w-full bg-slate-950 p-3 rounded border border-slate-700" />
        <button type="submit" class="w-full bg-blue-600 py-3 rounded-lg font-bold">Login</button>
      </form>
    </div>
  </main>
</Layout>
