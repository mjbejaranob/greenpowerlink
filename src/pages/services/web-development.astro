---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const features = [
  "Custom Web Applications (React, Astro, Node.js)",
  "CMS Integration (Headless CMS for content management)",
  "Booking & Appointment Management Systems",
  "E-commerce & Secure Payment Integration",
  "SEO Optimization & Performance Auditing",
  "Secure Hosting & Infrastructure Setup"
];
---

<ServiceLayout 
  title="Web Development" 
  description="High-performance digital platforms. From custom web applications to scalable business portals, I build secure, fast, and modern web infrastructure."
  features={features}
>
  <div class="mt-10 p-6 bg-blue-900/20 border border-blue-500/30 rounded-xl">
    <h3 class="text-xl font-bold mb-4 text-blue-300">Live Project Showcase</h3>
    <p class="mb-6 text-slate-300">Experience high-level, production-ready interfaces. Our demos showcase advanced logic, booking flows, e-commerce integrations, and real-time data visualization tools.</p>
    <a href="/demo/" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-lg font-bold transition-all">Explore Live Demos</a>
  </div>
</ServiceLayout>
