---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const features = [
  "End-to-End Product Design Lifecycle",
  "Rapid Prototyping & Iterative Design",
  "Design for Manufacturing (DFM)",
  "Technical Documentation & Specifications",
  "Compliance Standards Analysis",
  "EMC Testing Support & Pre-compliance Testing"
];

const roadmap = [
  { step: '01', title: 'Idea', desc: 'Concept Generation' },
  { step: '02', title: 'Design', desc: 'Engineering & CAD' },
  { step: '03', title: 'Prototyping', desc: 'Iterative Validation' },
  { step: '04', title: 'Manufacturing', desc: 'Production Setup' },
  { step: '05', title: 'Testing', desc: 'Compliance & QA' },
  { step: '06', title: 'Distribution', desc: 'Market Launch' },
];
---

<ServiceLayout 
  title="Product Development" 
  description="Turn concepts into reality. I guide your product through the entire lifecycle, including prototyping, iterative design, and manufacturing readiness."
  features={features}
>
  <div class="mt-16 space-y-16">
    <!-- Professional Lifecycle Roadmap -->
    <div class="py-8">
      <h3 class="text-3xl font-extrabold mb-16 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-green-400">Engineering Lifecycle Roadmap</h3>
      <div class="relative">
        <!-- Connector Line -->
        <div class="absolute left-8 lg:left-0 lg:right-0 top-0 bottom-0 w-0.5 bg-slate-800 lg:w-full lg:h-0.5 lg:top-8"></div>
        
        <div class="grid grid-cols-1 lg:grid-cols-6 gap-8">
          {roadmap.map((item, index) => (
            <div class="relative flex lg:flex-col items-center">
              <div class="w-16 h-16 rounded-full bg-slate-900 border-4 border-slate-950 flex items-center justify-center text-xl font-bold text-teal-400 shadow-xl z-10 transition-transform hover:scale-110">
                {item.step}
              </div>
              <div class="ml-6 lg:ml-0 lg:mt-6 text-left lg:text-center">
                <h4 class="font-bold text-lg text-slate-100">{item.title}</h4>
                <p class="text-xs font-medium uppercase tracking-widest text-slate-500">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Compliance Section -->
    <div class="grid md:grid-cols-2 gap-8">
      <div class="p-6 bg-slate-800/50 rounded-xl border border-slate-700 hover:border-teal-500/50 transition-colors">
        <h4 class="font-bold text-lg mb-3 text-teal-400">Compliance Analysis</h4>
        <p class="text-sm text-slate-400">Full analysis of regulatory standards (FCC, CE, UL) applicable to your product domain, ensuring market-entry readiness.</p>
      </div>
      <div class="p-6 bg-slate-800/50 rounded-xl border border-slate-700 hover:border-teal-500/50 transition-colors">
        <h4 class="font-bold text-lg mb-3 text-teal-400">EMC Testing Support</h4>
        <p class="text-sm text-slate-400">Pre-compliance electromagnetic compatibility testing to identify and resolve noise issues early, avoiding costly certification failures.</p>
      </div>
    </div>
  </div>
</ServiceLayout>
