---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GreenPowerLink | Contact Us">
  <main class="min-h-screen bg-slate-950 text-slate-100 font-sans p-8 md:p-16 max-w-2xl mx-auto">
    <a href="/" class="text-blue-400 hover:text-blue-300 font-bold mb-8 inline-block">← Back to Main Site</a>
    <h1 class="text-4xl font-extrabold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-green-400">Get in Touch</h1>
    
    <form action="https://formspree.io/f/mnqeolqe" method="POST" class="space-y-6 bg-slate-900/50 p-8 rounded-3xl border border-slate-700 backdrop-blur-sm">
      <div>
        <label class="block mb-2 text-sm font-semibold text-slate-300">Your Name</label>
        <input type="text" name="name" required class="w-full bg-slate-950 p-4 rounded-xl border border-slate-700 focus:border-green-500 outline-none transition-all" />
      </div>
      <div>
        <label class="block mb-2 text-sm font-semibold text-slate-300">Email Address</label>
        <input type="email" name="email" required class="w-full bg-slate-950 p-4 rounded-xl border border-slate-700 focus:border-green-500 outline-none transition-all" />
      </div>
      <div>
        <label class="block mb-2 text-sm font-semibold text-slate-300">Message</label>
        <textarea name="message" rows="4" required class="w-full bg-slate-950 p-4 rounded-xl border border-slate-700 focus:border-green-500 outline-none transition-all"></textarea>
      </div>
      <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-green-600 py-4 rounded-xl text-white font-bold transition-all shadow-lg hover:shadow-blue-900/50">
        Send Message
      </button>
    </form>
  </main>
</Layout>
